{
  "name": "dsh-token-quota",
  "version": "2.1.0",
  "description": "DeepSeek Harness 用量监控：7 个白名单供应商（DeepSeek／OpenRouter／OpenCode／Command Code／Fireworks／OpenDesign）的周期限额、余额、报告费用与本地今日用量；控制台会话与官方 HTTP 方法分离，范围收敛为代码级冻结白名单。",
  "author": "shxtmaker <https://github.com/shxtmaker>",
  "license": "MIT",
  "homepage": "https://github.com/shxtmaker/dsh-token-quota",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shxtmaker/dsh-token-quota.git"
  },
  "bugs": {
    "url": "https://github.com/shxtmaker/dsh-token-quota/issues"
  },
  "files": [
    "lib",
    "test",
    "scripts",
    "playwright.config.mjs",
    "cordis.patch.yml",
    "README.md",
    "docs/windows-desktop-adaptation.md",
    "docs/provider-upgrade-migration.md",
    "CONTEXT.md",
    "ui-prototype.html"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.7-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "playwright-core": "^1.63.0"
  },
  "scripts": {
    "test": "node --test test/*.mjs",
    "test:browser": "playwright test",
    "test:desktop": "node scripts/verify-desktop.mjs",
    "test:lifecycle": "node scripts/verify-lifecycle.cjs",
    "test:pack": "node scripts/check-package.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "react-dom": "^18.3.1",
    "react-test-renderer": "^18.3.1"
  }
}
